{
  "name": "@aid-on/didoq",
  "version": "1.2.2",
  "description": "DidoQ - Fluent API with nagare Stream integration for Cloudflare job queues",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node bench/run.mjs"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "durable-objects",
    "d1",
    "queue",
    "fluent-api",
    "nagare",
    "streaming"
  ],
  "license": "MIT",
  "dependencies": {
    "@aid-on/nagare": "^0.2.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild@0.21.5": "~0.25.0",
    "tinypool@0.8.4": "^2.1.2",
    "vite@5.4.21": "^6.4.3",
    "tinypool@1.1.1": "^2.1.2",
    "@vitest/mocker@3.2.7": "^4.1.11"
  }
}
