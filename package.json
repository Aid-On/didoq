    "test:watch": "vitest"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "durable-objects",
    "d1",
    "queue",
    "fluent-api",
    "nagare",
    "streaming"
  ],
  "license": "MIT",
  "dependencies": {
    "@aid-on/nagare": "^0.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
