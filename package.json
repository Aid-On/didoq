{
  "name": "@aid-on/didoq",
  "version": "1.2.1",
  "description": "DidoQ - Fluent API with nagare Stream integration for Cloudflare job queues",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
